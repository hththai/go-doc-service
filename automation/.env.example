# Copy to automation/.env and fill in. Never commit .env.

# LLM used by every agent (any LiteLLM / crewAI model string works,
# e.g. openai/gpt-5, ollama/qwen3-coder).
MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Who writes the code:
#   crew        -> crewAI developer agents edit files through sandboxed tools
#   claude-code -> the developer step runs `claude -p` headless in the worktree
CODER=crew

# Implement -> verify -> review loop limit
MAX_ATTEMPTS=3

# Client test command (root CLAUDE.md says pnpm; lefthook uses npm)
CLIENT_TEST_CMD=pnpm test

# Where worktrees are created (default: a sibling folder "2_Go-worktrees")
# WORKTREE_ROOT=/Users/you/Documents/0_Projects/2_Go-worktrees

# Tracing UI (Arize Phoenix). Needs: uv sync --extra tracing
# and Phoenix running: docker compose -f phoenix/docker-compose.yml up -d
# Then open http://localhost:6006
TRACING=
# TRACING=phoenix
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_PROJECT_NAME=dev-crew

# Optional: turn off crewAI telemetry
# CREWAI_DISABLE_TELEMETRY=true
# OTEL_SDK_DISABLED=true
