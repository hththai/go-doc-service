pipeline {
    agent any

    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['production', 'staging', 'development'], description: 'Target deployment environment')
    }

    environment {
        CLIENT_DOMAIN = 'box.hthai.cloud'
        VITE_API_URL  = "https://${CLIENT_DOMAIN}/go"
        IMAGE_NAME    = '2go-client-vite'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                dir('client-vite/client-vite') {
                    sh 'docker build --target test .'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('client-vite/client-vite') {
                    sh "docker build --build-arg VITE_API_URL=${VITE_API_URL} -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('Check API') {
            // The client must not go live before the server it calls. A deployed
            // server answers 401 (not logged in) for this route; an older server
            // without the maintenance API answers 404. Deploy the server job first.
            steps {
                sh '''#!/bin/bash
                    set -euo pipefail
                    URL="${VITE_API_URL}/v1/auth/maintenance/verify"
                    # curl prints 000 when the server cannot be reached.
                    CODE=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "$URL" || true)
                    echo "GET $URL -> $CODE"
                    case "$CODE" in
                        401|200) echo "Server API is up to date." ;;
                        404) echo "Server is missing /maintenance endpoints. Deploy the server pipeline first."; exit 1 ;;
                        *)   echo "Server API not reachable or unhealthy (HTTP $CODE)."; exit 1 ;;
                    esac
                '''
            }
        }

        stage('Deploy') {
            steps {
                dir('client-vite/client-vite') {
                    sh """
                        export CLIENT_DOMAIN=${CLIENT_DOMAIN}
                        docker-compose -f docker-compose.prod.yml down --remove-orphans || true
                        docker-compose -f docker-compose.prod.yml up -d
                    """
                }
            }
        }
    }

    post {
        success {
            echo 'Client Vite deployed successfully!'
        }
        failure {
            echo 'Client Vite build failed!'
        }
    }
}
