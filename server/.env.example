# Database Configuration
DB_ROOT_PASSWORD=your_root_password
DB_NAME=goDocument
DB_USER=appuser
DB_PASSWORD=your_root_password
DB_HOST=127.0.0.1
DB_PORT=3307

# API Configuration
GO_ENV=production
API_PORT=8088
JWT_SECRET=your_root_secret
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Note: Traefik domain config is in Jenkinsfile environment block
# and gets injected into dynamic/config.yml during build

# Rate Limiting (production only)
RATE_LIMIT_REQUESTS=10

# Anthropic (OCR)
ANTHROPIC_API_KEY=your_anthropic_api_key
